digraph Workflow {
graph [fontname="Arial", fontsize=15, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45"];
node [fontname="Arial", fontsize=14, shape=box, style="rounded,filled", fillcolor="#f3f7f0", color="#91ad9c", fontcolor="#24483b", margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, color="#577a67", arrowsize=0.7];
graph [rankdir=TB,ranksep=0.3];
request [label="Yêu cầu tạo hoặc sửa lịch"];
validate [label="Kiểm tra dữ liệu và khoảng giờ"];
lock [label="BEGIN · Khóa xe theo ID tăng dần
Sau đó khóa tài xế và lịch cần sửa"];
check [label="Có lịch mở giao nhau?",shape=diamond,fillcolor="#fff8e9"];
reject [label="ROLLBACK
Thông báo xung đột HTTP 409",fillcolor="#fff2ed"];
save [label="Ghi lịch và tăng version"];
commit [label="COMMIT
Ghi log và trả kết quả"];
request -> validate -> lock -> check;
check -> reject [label="Có"];
check -> save [label="Không"];
save -> commit;
}
