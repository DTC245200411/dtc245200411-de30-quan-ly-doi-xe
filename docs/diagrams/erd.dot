digraph ERD {
graph [fontname="Arial", fontsize=15, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45"];
node [fontname="Arial", fontsize=14, shape=box, style="rounded,filled", fillcolor="#f3f7f0", color="#91ad9c", fontcolor="#24483b", margin="0.18,0.13"];
edge [fontname="Arial", fontsize=11, color="#577a67", arrowsize=0.7];
graph [rankdir=TB, nodesep=0.4,ranksep=0.65];
node [shape=record,style=filled,fontsize=15,margin="0.15,0.15"];
vehicles [label="{vehicles|PK id : integer\lUQ code : varchar\lUQ plate : varchar\lodometer : integer\lstatus : varchar\l}"];
drivers [label="{drivers|PK id : integer\lUQ code : varchar\lUQ license_no : varchar\lstatus : varchar\l}"];
trips [label="{trips|PK id : integer\lFK vehicle_id : integer NOT NULL\lFK driver_id : integer NOT NULL\lUQ code : varchar\lstart_at / end_at : timestamptz\lstatus : varchar\l}"];
maintenance [label="{maintenance|PK id : integer\lFK vehicle_id : integer NOT NULL\lUQ code : varchar\lstart_at / end_at : timestamptz\lstatus : varchar\lcost_vnd : numeric(14,0)\l}"];
{rank=same;vehicles;drivers;}
{rank=same;maintenance;trips;}
vehicles -> trips [dir=both,arrowtail=tee,arrowhead=crow,taillabel="1",headlabel="0..*",label="được điều phối"];
drivers -> trips [dir=both,arrowtail=tee,arrowhead=crow,taillabel="1",headlabel="0..*",label="thực hiện"];
vehicles -> maintenance [dir=both,arrowtail=tee,arrowhead=crow,taillabel="1",headlabel="0..*",label="được bảo dưỡng"];
}
