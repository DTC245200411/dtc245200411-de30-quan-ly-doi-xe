      "targets": [
        {
          "refId": "A",
          "expr": "sum by(container_label_com_docker_compose_service)(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"de30lam\",container_label_com_docker_compose_service=~\"app|nginx|postgres\"}[2m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
