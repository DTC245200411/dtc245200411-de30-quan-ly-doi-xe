<%- include('partials/header') %><section class="page-heading"><div><span class="eyebrow"><%= kind==='trip'?'ĐIỀU PHỐI HÀNH TRÌNH':'CHĂM SÓC PHƯƠNG TIỆN' %></span><h1><%= title %><span class="title-dot">.</span></h1><p><%= kind==='trip'?'Sắp xếp chuyến đi, kết nối xe và tài xế.':'Theo dõi từng lần bảo dưỡng và chi phí thực tế.' %></p></div><a class="button primary" href="/<%= resource %>/new"><%- icon('plus') %> <%= kind==='trip'?'Lập lịch chuyến đi':'Lập lịch bảo dưỡng' %></a></section><nav class="status-tabs" aria-label="Lọc trạng thái"><a class="<%= !state?'selected':'' %>" href="/<%= resource %>?q=<%= encodeURIComponent(q) %>">Tất cả</a><% for(const [value,label] of Object.entries(states)){ %><a class="<%= state===value?'selected':'' %>" href="/<%= resource %>?status=<%= value %>&q=<%= encodeURIComponent(q) %>"><%= label %></a><% } %></nav><section class="panel"><form class="filters" action="/<%= resource %>"><input type="hidden" name="status" value="<%= state %>"><label class="search-box"><%- icon('search') %><input name="q" value="<%= q %>" aria-label="Tìm lịch" placeholder="<%= kind==='trip'?'Tìm mã chuyến, biển số, tuyến, tài xế':'Tìm mã phiếu, biển số, nội dung' %>"></label><button class="button secondary">Tìm kiếm</button><a class="clear-filter" href="/<%= resource %>">Đặt lại</a><span class="result-count"><%= rows.length %> lịch phù hợp</span></form><%- include('partials/booking-table',{rows,kind}) %></section><% if(kind==='maintenance'){const overdue=rows.filter(r=>r.status==='planned'&&new Date(r.start_at)<now).length; %><p class="data-note"><%- icon('clock') %> <%= overdue %> lịch dự kiến đã quá giờ bắt đầu trong danh sách đang xem.</p><% } %><%- include('partials/footer') %>
