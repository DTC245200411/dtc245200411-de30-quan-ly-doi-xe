<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#174d43"><title><%= title %> · Lam Fleet</title><link rel="stylesheet" href="/style.css"></head><body>
