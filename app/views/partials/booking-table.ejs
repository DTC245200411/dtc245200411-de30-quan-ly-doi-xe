<% if(!rows.length){ %><div class="empty"><%- icon('calendar') %><h3>Chưa có lịch phù hợp</h3><p>Thử thay đổi bộ lọc hoặc tạo một lịch mới.</p></div><% }else{ %><div class="table-scroll"><table><thead><tr><th><%= kind==='trip'?'Chuyến đi / Tuyến đường':'Phiếu / Nội dung' %></th><th>Xe<%= kind==='trip'?' / Tài xế':'' %></th><th>Thời gian dự kiến</th><th>Trạng thái</th><th><span class="sr-only">Chi tiết</span></th></tr></thead><tbody><% for(const b of rows){ %><tr><td><a class="record-link" href="/<%= kind==='trip'?'trips':'maintenance' %>/<%= b.id %>"><%= b.code %></a><span class="subline"><%= kind==='trip'?b.origin+' → '+b.destination:b.title %></span></td><td><strong class="plate"><%= b.plate %></strong><span class="subline"><%= kind==='trip'?b.driver_name:b.vehicle_name %></span></td><td><span class="time"><%= date(b.start_at) %></span><span class="subline">đến <%= date(b.end_at) %></span></td><td><span class="badge <%= b.status %>"><span></span><%= states[b.status] %></span></td><td><a class="row-action" href="/<%= kind==='trip'?'trips':'maintenance' %>/<%= b.id %>" aria-label="Chi tiết <%= b.code %>"><%- icon('chevron') %></a></td></tr><% } %></tbody></table></div><% } %>
