<%- include('partials/header') %><section class="page-heading"><div><span class="eyebrow">BẢNG ĐIỀU HÀNH</span><h1>Tổng quan đội xe<span class="title-dot">.</span></h1><p>Theo dõi hành trình, chủ động từng lịch bảo dưỡng.</p></div><a class="button primary" href="/trips/new"><%- icon('plus') %> Lập lịch chuyến đi</a></section>
<section class="welcome-panel"><div><span class="eyebrow light">LAM FLEET / HÔM NAY</span><h2>Chào Lam, sẵn sàng<br>cho những chuyến đi?</h2><p><%= counts.available %> xe đang sẵn sàng · <%= stats.drivers %> tài xế đang hoạt động</p><a href="/vehicles">Xem tình trạng đội xe <%- icon('arrow') %></a></div><div class="fleet-visual" aria-label="Tình trạng đội xe"><div class="visual-head"><span class="live-dot"></span> TÌNH TRẠNG ĐỘI XE <strong><%= counts.total %> XE</strong></div><div class="vehicle-track"><% for(const v of vehicles){ %><a title="<%= v.name %> · <%= v.plate %>" href="/vehicles/<%= v.id %>" class="vehicle-tile <%= v.operating %>"><%- icon('truck') %><small><%= v.code.replace('XE-','') %></small></a><% } %></div><div class="visual-legend"><span><i class="legend-dot available"></i>Sẵn sàng</span><span><i class="legend-dot on_trip"></i>Đang chạy</span><span><i class="legend-dot maintenance"></i>Bảo dưỡng</span></div></div></section>
<section class="stats-grid" aria-label="Thống kê"><% for(const [label,value,caption,symbol,tone] of [['Tổng số xe',counts.total,'Toàn bộ phương tiện','truck','teal'],['Xe sẵn sàng',counts.available,'Có thể nhận chuyến mới','check','green'],['Đang trên hành trình',counts.on_trip,'Chuyến đang thực hiện','route','blue'],['Đang bảo dưỡng',counts.maintenance,'Chờ hoàn tất kiểm tra','tool','amber']]){ %><article class="stat"><div class="stat-top"><span><%= label %></span><span class="stat-icon <%= tone %>"><%- icon(symbol) %></span></div><strong><%= value %><small>xe</small></strong><p><%= caption %></p></article><% } %></section>
<div class="dashboard-columns"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">ĐIỀU PHỐI</span><h2>Những chuyến đi tiếp theo</h2></div><a class="text-link" href="/trips">Tất cả <%- icon('arrow') %></a></div><%- include('partials/booking-table',{rows:trips,kind:'trip'}) %><div class="panel-bottom"><span><%- icon('check') %> <%= stats.completed %> chuyến đã hoàn tất</span><a href="/trips?status=completed">Xem lịch sử</a></div></section>
<section class="panel maintenance-panel"><div class="panel-heading"><div><span class="eyebrow">CHỦ ĐỘNG CHĂM SÓC</span><h2>Lịch bảo dưỡng</h2></div><a class="row-action" href="/maintenance" aria-label="Tất cả bảo dưỡng"><%- icon('arrow') %></a></div><div class="due-list"><% for(const m of due){const overdue=m.status==='planned'&&new Date(m.start_at)<now; %><a class="due-item" href="/maintenance/<%= m.id %>"><span class="due-icon <%= overdue?'overdue':'' %>"><%- icon('tool') %></span><div><strong><%= m.plate %></strong><p><%= m.title %></p><small class="<%= overdue?'overdue-text':'' %>"><%= overdue?'Quá hạn · ':m.status==='in_progress'?'Đang thực hiện · ':'' %><%= date(m.start_at) %></small></div><%- icon('chevron') %></a><% } %><% if(!due.length){ %><div class="empty">Không có lịch bảo dưỡng mở.</div><% } %></div><div class="panel-bottom"><span>Chi phí đã ghi nhận</span><strong><%= money(stats.cost) %></strong></div></section></div><%- include('partials/footer') %>
