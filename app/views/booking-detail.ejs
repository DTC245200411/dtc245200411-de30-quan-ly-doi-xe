<%- include('partials/header') %><section class="page-heading"><div><a class="back-link" href="/<%= resource %>">← <%= kind==='trip'?'Lịch trình':'Bảo dưỡng' %></a><h1><%= record.code %><span class="title-dot">.</span></h1><p><%= kind==='trip'?record.origin+' → '+record.destination:record.title %></p></div><span class="badge large-badge <%= record.status %>"><span></span><%= states[record.status] %></span></section><div class="form-layout"><section class="panel form-panel"><h2>Chi tiết <%= kind==='trip'?'chuyến đi':'bảo dưỡng' %></h2><dl class="details-grid"><div><dt>Phương tiện</dt><dd><a href="/vehicles/<%= record.vehicle_id %>"><%= record.plate %> · <%= record.vehicle_name %></a></dd></div><% if(kind==='trip'){ %><div><dt>Tài xế</dt><dd><a href="/drivers/<%= record.driver_id %>"><%= record.driver_name %></a></dd></div><div><dt>Điểm đi</dt><dd><%= record.origin %></dd></div><div><dt>Điểm đến</dt><dd><%= record.destination %></dd></div><% }else{ %><div><dt>Đơn vị thực hiện</dt><dd><%= record.provider||'Chưa ghi nhận' %></dd></div><% } %><div><dt>Bắt đầu dự kiến</dt><dd><%= date(record.start_at) %></dd></div><div><dt>Kết thúc dự kiến</dt><dd><%= date(record.end_at) %></dd></div><div><dt>Bắt đầu thực tế</dt><dd><%= date(record.started_at) %></dd></div><div><dt>Kết thúc thực tế</dt><dd><%= date(record.finished_at) %></dd></div><% if(kind==='trip'){ %><div><dt>Km đầu chuyến</dt><dd><%= record.start_odometer===null?'—':number(record.start_odometer)+' km' %></dd></div><div><dt>Km cuối chuyến</dt><dd><%= record.end_odometer===null?'—':number(record.end_odometer)+' km' %></dd></div><% }else{ %><div><dt>Chi phí thực tế</dt><dd><%= money(record.cost_vnd) %></dd></div><div><dt>Km ghi nhận</dt><dd><%= record.odometer===null?'—':number(record.odometer)+' km' %></dd></div><div class="span-two"><dt>Kết quả</dt><dd><%= record.result||'Chưa ghi nhận' %></dd></div><% } %></dl><% if(record.notes){ %><p class="data-note"><%= record.notes %></p><% } %><% if(record.status==='planned'){ %><div class="form-actions"><a class="button secondary" href="/<%= resource %>/<%= record.id %>/edit">Điều chỉnh lịch</a><form method="post" action="/<%= resource %>/<%= record.id %>/start"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= record.version %>"><button class="button primary">Bắt đầu <%- icon('arrow') %></button></form></div><% } %></section><aside class="form-aside"><% if(record.status==='in_progress'){ %><h3>Hoàn tất công việc</h3><p>Ghi nhận kilomet thực tế để cập nhật hồ sơ xe.</p><form method="post" action="/<%= resource %>/<%= record.id %>/complete"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= record.version %>"><label>Số kilomet kết thúc<input type="number" name="odometer" min="<%= record.current_odometer %>" max="1000000000" step="1" required value="<%= record.current_odometer %>"></label><% if(kind==='maintenance'){ %><label>Chi phí thực tế (VND)<input type="number" name="cost_vnd" min="0" step="1" max="99999999999999" required value="0"></label><label>Kết quả<textarea name="result" rows="3" maxlength="2000" required></textarea></label><% } %><button class="button primary full">Hoàn tất <%- icon('check') %></button></form><% }else if(record.status==='planned'){ %><h3>Cần thay đổi kế hoạch?</h3><p>Bạn có thể điều chỉnh giờ, phương tiện hoặc hủy trước khi lịch bắt đầu.</p><form method="post" action="/<%= resource %>/<%= record.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= record.version %>"><button class="button danger">Hủy lịch này</button></form><% }else{ %><span class="aside-icon"><%- icon('check') %></span><h3>Lịch sử được lưu giữ</h3><p>Phiếu đã kết thúc được giữ để đối chiếu và không chỉnh sửa lại.</p><% } %></aside></div><%- include('partials/footer') %>
