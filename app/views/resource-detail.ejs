<%- include('partials/header') %><section class="page-heading"><div><a class="back-link" href="/<%= resource %>">← <%= resource==='vehicles'?'Đội xe':'Tài xế' %></a><h1><%= record.name %><span class="title-dot">.</span></h1><p><%= record.code %> · Hồ sơ và lịch sử hoạt động</p></div><a class="button secondary" href="/<%= resource %>/<%= record.id %>/edit">Cập nhật hồ sơ <%- icon('arrow') %></a></section><section class="panel detail-summary"><% if(resource==='vehicles'){ %><div><small>BIỂN SỐ</small><strong class="plate"><%= record.plate %></strong></div><div><small>LOẠI XE</small><strong><%= record.type %></strong></div><div><small>SỐ KILOMET</small><strong><%= number(record.odometer) %> km</strong></div><% }else{ %><div><small>ĐIỆN THOẠI</small><strong><%= record.phone %></strong></div><div><small>GIẤY PHÉP</small><strong><%= record.license_no %></strong></div><% } %><div><small>TRẠNG THÁI HỒ SƠ</small><strong><%= record.status==='active'?'Đang hoạt động':'Ngừng hoạt động' %></strong></div></section><% if(record.notes){ %><p class="data-note"><%= record.notes %></p><% } %><section class="panel section-gap"><div class="panel-heading"><h2>Lịch trình và lịch sử chuyến đi</h2></div><%- include('partials/booking-table',{rows:trips,kind:'trip'}) %></section><% if(resource==='vehicles'){ %><section class="panel section-gap"><div class="panel-heading"><h2>Lịch sử bảo dưỡng</h2></div><%- include('partials/booking-table',{rows:maintenance,kind:'maintenance'}) %></section><% } %><%- include('partials/footer') %>
