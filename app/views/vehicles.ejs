<%- include('partials/header') %><section class="page-heading"><div><span class="eyebrow">PHƯƠNG TIỆN</span><h1>Đội xe<span class="title-dot">.</span></h1><p>Hồ sơ phương tiện và tình trạng vận hành tại một nơi.</p></div><a class="button primary" href="/vehicles/new"><%- icon('plus') %> Thêm xe mới</a></section><section class="panel"><form class="filters" action="/vehicles"><label class="search-box"><%- icon('search') %><input name="q" value="<%= q %>" placeholder="Tìm mã xe, biển số, tên xe" aria-label="Tìm xe"></label><select name="status" aria-label="Trạng thái hoạt động"><option value="">Tất cả trạng thái</option value="active" <%= state==='active'?'selected':'' %>>Đang hoạt động</option><option value="retired" <%= state==='retired'?'selected':'' %>>Ngừng sử dụng</option></select><button class="button secondary">Lọc danh sách</button><a class="clear-filter" href="/vehicles">Đặt lại</a><span class="result-count"><%= rows.length %> phương tiện</span></form><div class="table-scroll"><table><thead><tr><th>Phương tiện</th><th>Biển số</th><th>Loại xe</th><th>Số kilomet</th><th>Tình trạng</th><th></th></tr></thead><tbody><% for(const v of rows){const labels={available:'Sẵn sàng',on_trip:'Đang chạy',maintenance:'Bảo dưỡng',retired:'Ngừng sử dụng'}; %><tr><td><div class="cell-person"><span class="vehicle-avatar"><%- icon('truck') %></span><div><a class="record-link" href="/vehicles/<%= v.id %>"><%= v.name %></a><span class="subline"><%= v.code %></span></div></div></td><td><strong class="plate"><%= v.plate %></strong></td><td><%= v.type %></td><td class="numeric"><%= number(v.odometer) %> <small>km</small></td><td><span class="badge <%= v.operating %>"><span></span><%= labels[v.operating] %></span></td><td><a class="row-action" aria-label="Chi tiết <%= v.code %>" href="/vehicles/<%= v.id %>"><%- icon('chevron') %></a></td></tr><% } %></tbody></table><% if(!rows.length){ %><div class="empty">Không có xe phù hợp với bộ lọc.</div><% } %></div></section><%- include('partials/footer') %>
