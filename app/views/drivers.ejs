<%- include('partials/header') %><section class="page-heading"><div><span class="eyebrow">ĐỘI NGŨ</span><h1>Tài xế<span class="title-dot">.</span></h1><p>Quản lý hồ sơ và lịch trình của từng tài xế.</p></div><a class="button primary" href="/drivers/new"><%- icon('plus') %> Thêm tài xế</a></section><form class="filters standalone" action="/drivers"><label class="search-box"><%- icon('search') %><input name="q" value="<%= q %>" placeholder="Tìm tên, mã tài xế, giấy phép" aria-label="Tìm tài xế"></label><select name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="active" <%= state==='active'?'selected':'' %>>Đang hoạt động</option><option value="inactive" <%= state==='inactive'?'selected':'' %>>Ngừng hoạt động</option></select><button class="button secondary">Lọc danh sách</button><a class="clear-filter" href="/drivers">Đặt lại</a></form><div class="driver-grid"><% for(const r of rows){ %><article class="driver-card"><div class="driver-card-top"><span class="avatar large"><%= initials(r.name) %></span><span class="badge <%= r.status==='active'?'available':'retired' %>"><span></span><%= r.status==='active'?'Hoạt động':'Tạm nghỉ' %></span></div><a href="/drivers/<%= r.id %>"><h2><%= r.name %></h2></a><p class="muted"><%= r.code %></p><dl><div><dt>Điện thoại</dt><dd><%= r.phone %></dd></div><div><dt>Giấy phép</dt><dd><%= r.license_no %></dd></div></dl><a class="driver-link" href="/drivers/<%= r.id %>">Hồ sơ và lịch trình <%- icon('arrow') %></a></article><% } %></div><% if(!rows.length){ %><div class="panel empty">Không có tài xế phù hợp.</div><% } %><p class="data-note">Các hồ sơ khởi tạo là dữ liệu minh họa phục vụ bài thực hành.</p><%- include('partials/footer') %>
